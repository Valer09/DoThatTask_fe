<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!--
	  ATS exception scoped to local networking only. iOS otherwise blocks
	  every plaintext HTTP request (the dev/staging profiles use http to
	  reach a backend on `localhost` or a LAN IP). NSAllowsLocalNetworking
	  permits `localhost`, `*.local` and RFC1918 (10/172.16/192.168) ranges
	  while keeping HTTPS enforcement intact for the production profile.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
